# Copy to ops/env on the server (ops/env is git-ignored). No API keys are needed:
# the paper trader and the live logger use Kalshi's public market data only.
CODE_BRANCH=feat/vm-runner      # branch whose code the server runs; switch to main once merged
DATA_BRANCH=data/vm-logs        # branch the server commits its logs to (pushes here run no Actions)
TESTS="tests -q -x"             # what the daily job runs before it accepts new code
