[Unit]
Description=Tennis Quant Lab: Kalshi Challenger paper market-maker (public data, no orders)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/python scripts/paper_trade_kalshi.py poll --minutes 1440 --interval 60
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
